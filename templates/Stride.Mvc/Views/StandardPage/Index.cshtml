@model StandardPageViewModel
@using Stride.Mvc._1.Models.Pages
@using Stride.Mvc._1.Models.ViewModels

@{ Layout = "~/Views/Shared/Layouts/_LeftNavigation.cshtml"; }

<h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-8">
    @Model.CurrentPage.Name
</h1>

@if (Model.CurrentPage.MainBody != null && !Model.CurrentPage.MainBody.IsEmpty)
{
    <div class="prose prose-lg max-w-none mb-8" epi-property="@Model.CurrentPage.MainBody">
        @Html.PropertyFor(m => m.CurrentPage.MainBody)
    </div>
}

@if (Model.CurrentPage.MainContentArea != null && Model.CurrentPage.MainContentArea.Items.Any())
{
    @Html.PropertyFor(m => m.CurrentPage.MainContentArea)
}

@* News & Events overview — shown when this page has listing children *@
@if (Model.HasListingChildren)
{
    @* Latest News *@
    @foreach (var newsListing in Model.NewsListings)
    {
        <section class="mt-12">
            <h2 class="text-2xl font-bold tracking-tight mb-8">Latest News</h2>
            <div class="space-y-10">
                @foreach (var article in newsListing.Articles)
                {
                    <a href="@Url.ContentUrl(article.ContentLink)" class="group grid grid-cols-2 gap-6 items-start">
                        @if (article.FeaturedImage != null && !ContentReference.IsNullOrEmpty(article.FeaturedImage))
                        {
                            <div class="aspect-[3/2] rounded-lg overflow-hidden">
                                <img src="@Url.ContentUrl(article.FeaturedImage)"
                                     alt="@article.Title"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                            </div>
                        }
                        <div class="min-w-0">
                            <span class="text-xs font-bold uppercase tracking-wider text-key1 mb-1 block font-mono">
                                @article.PublishDate.ToString("MMMM d, yyyy")
                            </span>
                            <h3 class="text-lg font-bold mb-2 group-hover:text-key1 transition-colors">
                                @article.Title
                            </h3>
                            @if (article.Summary != null && !article.Summary.IsEmpty)
                            {
                                <p class="text-sm text-foreground/60 line-clamp-2">
                                    @System.Text.RegularExpressions.Regex.Replace(article.Summary.ToHtmlString(), "<[^>]*>", "")
                                </p>
                            }
                        </div>
                    </a>
                }
            </div>
            <div class="mt-8">
                <a href="@Url.ContentUrl(newsListing.Listing.ContentLink)"
                   class="inline-block px-6 py-2.5 text-sm font-semibold uppercase tracking-wider border-2 border-foreground/20 rounded hover:border-foreground/40 transition-colors">
                    All News
                </a>
            </div>
        </section>
    }

    @* Upcoming Events *@
    @foreach (var eventListing in Model.EventListings)
    {
        <section class="mt-16">
            <h2 class="text-2xl font-bold tracking-tight mb-8">Upcoming Events</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                @foreach (var evt in eventListing.Events)
                {
                    <a href="@Url.ContentUrl(evt.ContentLink)" class="group block border border-foreground/10 rounded-lg p-6 hover:border-foreground/20 transition-colors bg-foreground/[0.02] backdrop-blur-[3px]">
                        <span class="text-xs font-bold uppercase tracking-wider text-key1 mb-2 block font-mono">
                            @evt.EventDate.ToString("MMMM d, yyyy")
                        </span>
                        <h3 class="text-lg font-bold mb-2 group-hover:text-key1 transition-colors">
                            @evt.Title
                        </h3>
                        @if (!string.IsNullOrEmpty(evt.Location))
                        {
                            <p class="text-sm text-foreground/60 flex items-center gap-1 mb-2">
                                <i data-lucide="map-pin" class="w-3 h-3"></i>
                                @evt.Location
                            </p>
                        }
                        @if (evt.Description != null && !evt.Description.IsEmpty)
                        {
                            <p class="text-sm text-foreground/60">
                                @System.Text.RegularExpressions.Regex.Replace(evt.Description.ToHtmlString(), "<[^>]*>", "")
                            </p>
                        }
                    </a>
                }
            </div>
            <div class="mt-8">
                <a href="@Url.ContentUrl(eventListing.Listing.ContentLink)"
                   class="inline-block px-6 py-2.5 text-sm font-semibold uppercase tracking-wider border-2 border-foreground/20 rounded hover:border-foreground/40 transition-colors">
                    All Events
                </a>
            </div>
        </section>
    }
}
