@model TeamMemberElement

<div class="group h-full">
    @if (Model.Image != null && !ContentReference.IsNullOrEmpty(Model.Image))
    {
        <div class="relative aspect-video rounded-lg overflow-hidden mb-4">
            <img src="@Url.ContentUrl(Model.Image)" alt="@Model.Name" class="w-full h-full object-cover transition-transform group-hover:scale-105" epi-property="Image" />
        </div>
    }

    <h4 class="text-2xl font-bold tracking-tight mb-2" epi-property="Name">@Model.Name</h4>

    @if (Model.Bio != null && !Model.Bio.IsEmpty)
    {
        <div class="text-sm leading-relaxed text-foreground mt-4" epi-property="Bio">
            @Html.PropertyFor(x => x.Bio)
        </div>
    }

    <div class="text-sm space-y-1 mt-3">
        @if (!string.IsNullOrEmpty(Model.Email))
        {
            <div class="flex items-center gap-2" epi-property="Email">
                <i data-lucide="mail" class="w-3.5 h-3.5 text-foreground/40"></i>
                <a href="mailto:@Model.Email" class="text-key1 hover:underline">@Model.Email</a>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Phone))
        {
            <div class="flex items-center gap-2" epi-property="Phone">
                <i data-lucide="phone" class="w-3.5 h-3.5 text-foreground/40"></i>
                <a href="tel:@Model.Phone" class="text-key1 hover:underline">@Model.Phone</a>
            </div>
        }
    </div>
</div>
