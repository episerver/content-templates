@model Stride.Mvc._1.Models.Blocks.ButtonElement

@{
    var baseClasses = "cursor-pointer box-border rounded-md inline-flex hover:-translate-y-0.5 transition-transform duration-0 hover:duration-100 items-center justify-center px-6 py-3 text-sm font-semibold transition-colors duration-200 uppercase tracking-wider";
    var variantClasses = "border-2 border-key1 bg-key1 text-foreground-inverted";
}

@if (!ContentReference.IsNullOrEmpty(Model.Link))
{
    <a href="@Url.ContentUrl(Model.Link)" class="@baseClasses @variantClasses">
        @Model.Text
    </a>
}
else
{
    <button type="button" class="@baseClasses @variantClasses">
        @Model.Text
    </button>
}
