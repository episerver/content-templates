@model Stride.Mvc._1.Models.Blocks.ButtonElement

@{
    var baseClasses = "inline-flex items-center justify-center px-6 py-3 font-semibold rounded-lg transition-colors duration-200";
    var variantClasses = "bg-slate-900 text-white hover:bg-slate-800";
}

@if (!ContentReference.IsNullOrEmpty(Model.Link))
{
    <a href="@Url.ContentUrl(Model.Link)" class="@baseClasses @variantClasses">
        @Model.Text
    </a>
}
else
{
    <button type="button" class="@baseClasses @variantClasses">
        @Model.Text
    </button>
}
