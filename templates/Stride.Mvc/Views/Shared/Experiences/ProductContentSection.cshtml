@model Stride.Mvc._1.Models.Sections.ProductContentSection

<div class="product-content-section container py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <epi-grid class="lg:col-span-8 space-y-12">
            <epi-row>
                <epi-column>
                    <epi-component class="w-full" />
                </epi-column>
            </epi-row>
        </epi-grid>

        <aside class="lg:col-span-4">
            <div class="lg:sticky lg:top-32">
                @await Component.InvokeAsync("Sidebar")
            </div>
        </aside>
    </div>
</div>
