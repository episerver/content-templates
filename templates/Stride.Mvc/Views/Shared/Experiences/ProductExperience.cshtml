@model PageViewModel<ProductExperience>

@{
    Layout = "~/Views/Shared/Layouts/_Root.cshtml";
    ViewBag.HideDefaultContentAreas = true;
}

<div class="product-experience">
    <div class="pt-28 pb-4 text-center">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-foreground/60">
            <i data-lucide="@Model.CurrentPage.BadgeIcon" class="w-3.5 h-3.5"></i>
            Stride @Model.CurrentPage.BadgeLabel
        </span>
    </div>

    <experience-renderer experience="@Model.CurrentPage"></experience-renderer>
</div>
