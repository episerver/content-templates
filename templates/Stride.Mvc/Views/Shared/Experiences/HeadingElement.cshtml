@model Stride.Mvc._1.Models.Elements.HeadingElement

@{
    ViewData.TryGetCompositionRenderingNode(out var renderingNode);
    var level = (renderingNode?.DisplaySettings != null && renderingNode.DisplaySettings.TryGetValue("level", out var levelVal)) ? levelVal : "h2";
    var alignment = (renderingNode?.DisplaySettings != null && renderingNode.DisplaySettings.TryGetValue("alignment", out var alignVal)) ? alignVal : "left";

    var alignClass = alignment switch
    {
        "center" => "text-center mx-auto",
        "right" => "text-right",
        _ => ""
    };

    var classes = level switch
    {
        "h1" => "text-5xl md:text-7xl font-bold tracking-tight mb-6",
        "h2" => "text-4xl md:text-6xl font-bold tracking-tight mb-4",
        "h3" => "text-2xl md:text-2xl font-bold tracking-tight mb-4",
        "h4" => "text-xl md:text-lg font-semibold tracking-tight mb-4",
        "h5" => "text-md md:text-sm font-semibold mb-4 tracking-tight",
        "h6" => "text-base md:text-sm font-medium mb-4 tracking-tight",
        _ => "text-4xl md:text-6xl font-bold tracking-tight mb-4"
    };

    classes = $"{classes} {alignClass}".Trim();
}

@if (Model != null && !string.IsNullOrEmpty(Model.Text))
{
    @switch (level)
    {
        case "h1":
            <h1 class="@classes" epi-property="Text">@Model.Text</h1>
            break;
        case "h2":
            <h2 class="@classes" epi-property="Text">@Model.Text</h2>
            break;
        case "h3":
            <h3 class="@classes" epi-property="Text">@Model.Text</h3>
            break;
        case "h4":
            <h4 class="@classes" epi-property="Text">@Model.Text</h4>
            break;
        case "h5":
            <h5 class="@classes" epi-property="Text">@Model.Text</h5>
            break;
        case "h6":
            <h6 class="@classes" epi-property="Text">@Model.Text</h6>
            break;
        default:
            <h2 class="@classes" epi-property="Text">@Model.Text</h2>
            break;
    }
}
