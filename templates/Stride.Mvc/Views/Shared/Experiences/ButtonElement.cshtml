@model Stride.Mvc._1.Models.Blocks.ButtonElement

@{
    ViewData.TryGetCompositionRenderingNode(out var renderingNode);
    var variant = (renderingNode?.DisplaySettings != null && renderingNode.DisplaySettings.TryGetValue("variant", out var variantVal)) ? variantVal : "primary";
    var textColor = (renderingNode?.DisplaySettings != null && renderingNode.DisplaySettings.TryGetValue("textColor", out var textColorVal)) ? textColorVal : "default";

    var variantMap = new Dictionary<string, string>
    {
        { "primary", "border-2 border-key1 bg-key1 text-foreground-inverted" },
        { "blue", "border-2 border-key1 bg-key1 text-foreground-inverted" },
        { "outline", "border-2 border-foreground text-foreground" },
        { "secondary", "border-2 border-foreground text-foreground" },
        { "ghost", "bg-transparent text-foreground hover:bg-foreground/5" }
    };

    var textColorClass = textColor switch
    {
        "white" => "!text-white",
        "dark" => "!text-foreground",
        _ => ""
    };

    var baseClasses = "w-full cursor-pointer box-border rounded-md inline-flex hover:-translate-y-0.5 transition-transform duration-0 hover:duration-100 items-center justify-center px-6 py-3 text-sm font-semibold transition-colors duration-200 uppercase tracking-wider";

    variantMap.TryGetValue(variant, out var variantClasses);
    variantClasses ??= variantMap["primary"];
}

@if (!ContentReference.IsNullOrEmpty(Model.Link))
{
    <a href="@Url.ContentUrl(Model.Link)" class="@baseClasses @variantClasses @textColorClass">
        <span epi-property="Text">@Model.Text</span>
    </a>
}
else
{
    <button type="button" class="@baseClasses @variantClasses @textColorClass">
        <span epi-property="Text">@Model.Text</span>
    </button>
}
