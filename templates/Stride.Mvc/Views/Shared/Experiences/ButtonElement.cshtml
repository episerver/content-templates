@model Stride.Mvc._1.Models.Blocks.ButtonElement

@{
    ViewData.TryGetCompositionRenderingNode(out var renderingNode);
    var variant = (renderingNode?.DisplaySettings != null && renderingNode.DisplaySettings.TryGetValue("variant", out var variantVal)) ? variantVal : "primary";

    var variantMap = new Dictionary<string, string>
    {
        { "primary", "bg-slate-900 text-white hover:bg-slate-800" },
        { "blue", "bg-key1 text-white hover:bg-key1/90" },
        { "outline", "bg-transparent text-white border-2 border-white hover:bg-white/10" },
        { "secondary", "bg-white text-slate-900 border-2 border-slate-900 hover:bg-slate-50" },
        { "ghost", "bg-transparent text-slate-900 hover:bg-slate-100" }
    };

    var baseClasses = "inline-flex items-center justify-center px-6 py-3 font-semibold rounded-lg transition-colors duration-200 w-full";

    variantMap.TryGetValue(variant, out var variantClasses);
    variantClasses ??= variantMap["primary"];
}

@if (!ContentReference.IsNullOrEmpty(Model.Link))
{
    <a href="@Url.ContentUrl(Model.Link)" class="@baseClasses @variantClasses">
        <span epi-property="Text">@Model.Text</span>
    </a>
}
else
{
    <button type="button" class="@baseClasses @variantClasses">
        <span epi-property="Text">@Model.Text</span>
    </button>
}
