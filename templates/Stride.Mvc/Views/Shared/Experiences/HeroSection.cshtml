@model Stride.Mvc._1.Models.Sections.HeroSection

<epi-grid class="hero-section relative">
    <epi-styles>
        <epi-style name="height">
            <epi-style-map value="small" class="min-h-[400px]" />
            <epi-style-map value="medium" class="min-h-[600px]" />
            <epi-style-map value="large" class="min-h-[800px]" />
            <epi-style-map value="fullscreen" class="min-h-screen" />
        </epi-style>
    </epi-styles>

    <div class="bg-cover bg-center relative bg-no-repeat rounded-lg overflow-x-clip box-border w-full">
        @if (Model != null && Model.HeroImage != null && !ContentReference.IsNullOrEmpty(Model.HeroImage))
        {
            var mediaUrl = Url.ContentUrl(Model.HeroImage);
            var isVideo = mediaUrl?.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ?? false;

            if (isVideo)
            {
                <video src="@mediaUrl"
                       autoplay
                       loop
                       muted
                       playsinline
                       class="md:opacity-90 opacity-50 absolute inset-0 w-full h-full object-cover rounded-lg"
                       epi-property="HeroImage"></video>
            }
            else
            {
                <img src="@mediaUrl"
                     alt="Hero background"
                     class="md:opacity-90 opacity-50 absolute inset-0 w-full h-full object-cover rounded-lg"
                     epi-property="HeroImage" />
            }
        }

        @{
            var hasSideImage = Model?.SideImage != null && !ContentReference.IsNullOrEmpty(Model.SideImage);
            var hasHeading = !string.IsNullOrEmpty(Model?.Heading);
            var hasDescription = !string.IsNullOrEmpty(Model?.Description);
            var hasPrimaryButton = !string.IsNullOrEmpty(Model?.PrimaryButtonText);
            var hasSecondaryButton = !string.IsNullOrEmpty(Model?.SecondaryButtonText);
            var hasButtons = hasPrimaryButton || hasSecondaryButton;
        }

        @if (Model?.LayoutStyle == "two-column")
        {
            <div class="h-[90vh] max-h-[900px] relative z-10 w-full container px-5 mx-auto flex gap-12 items-center py-20">
                <div class="grow-[2] basis-0">
                    @if (hasHeading)
                    {
                        <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 drop-shadow-[white_0px_0px_25px] scroll-fade-up scroll-delay-1"
                            epi-property="Heading">@Model.Heading</h1>
                    }

                    @if (hasDescription)
                    {
                        <p class="text-lg leading-relaxed text-foreground mt-5 max-w-md mb-8 drop-shadow-[white_0px_0px_15px] scroll-fade-up scroll-delay-2"
                           epi-property="Description">@Model.Description</p>
                    }

                    @if (hasButtons)
                    {
                        <div class="flex flex-wrap gap-4 scroll-fade-up scroll-delay-3">
                            @if (hasPrimaryButton)
                            {
                                <a href="@Model.PrimaryButtonLink"
                                   class="cursor-pointer rounded-md px-6 py-3 font-medium transition-all border-2 border-key1 bg-key1 text-white hover:-translate-y-0.5 duration-100">
                                    <span epi-property="PrimaryButtonText">@Model.PrimaryButtonText</span>
                                </a>
                            }
                            @if (hasSecondaryButton)
                            {
                                <a href="@Model.SecondaryButtonLink"
                                   class="cursor-pointer rounded-md px-6 py-3 font-medium transition-all border-2 border-foreground hover:-translate-y-0.5 duration-100 drop-shadow-[white_0px_0px_5px]">
                                    <span epi-property="SecondaryButtonText">@Model.SecondaryButtonText</span>
                                </a>
                            }
                        </div>
                    }
                </div>

                @if (hasSideImage)
                {
                    <div class="grow basis-0 hidden md:block">
                        <div class="w-full relative aspect-[1/2.02] -mb-[100%]">
                            <img src="@Url.ContentUrl(Model.SideImage)"
                                 alt=""
                                 class="absolute -left-[32.9%] !max-w-[166%] -top-[10%] select-none pointer-events-none scroll-parallax"
                                 data-parallax-speed="0.85"
                                 draggable="false"
                                 epi-property="SideImage" />
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @if (Model?.HeroImage != null && !ContentReference.IsNullOrEmpty(Model.HeroImage))
            {
                <div class="absolute inset-0 bg-gradient-to-t from-background2 via-background2/60 to-background2/30 rounded-lg z-[1]"></div>
            }

            <div class="h-[90vh] max-h-[900px] relative z-10 w-full container px-5 mx-auto flex items-center justify-center py-20">
                <div class="max-w-3xl text-center space-y-6">
                    @if (hasHeading)
                    {
                        <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 scroll-fade-up scroll-delay-1"
                            epi-property="Heading">@Model.Heading</h1>
                    }

                    @if (hasDescription)
                    {
                        <p class="text-lg leading-relaxed text-foreground/80 mt-5 max-w-2xl mx-auto scroll-fade-up scroll-delay-2"
                           epi-property="Description">@Model.Description</p>
                    }

                    @if (hasButtons)
                    {
                        <div class="flex flex-wrap justify-center gap-4 scroll-fade-up scroll-delay-3">
                            @if (hasPrimaryButton)
                            {
                                <a href="@Model.PrimaryButtonLink"
                                   class="cursor-pointer rounded-md px-6 py-3 font-medium transition-all border-2 border-key1 bg-key1 text-white hover:-translate-y-0.5 duration-100">
                                    <span epi-property="PrimaryButtonText">@Model.PrimaryButtonText</span>
                                </a>
                            }
                            @if (hasSecondaryButton)
                            {
                                <a href="@Model.SecondaryButtonLink"
                                   class="cursor-pointer rounded-md px-6 py-3 font-medium transition-all border-2 border-foreground hover:-translate-y-0.5 duration-100">
                                    <span epi-property="SecondaryButtonText">@Model.SecondaryButtonText</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <epi-row class="hidden">
        <epi-column>
            <epi-component/>
        </epi-column>
    </epi-row>
</epi-grid>
