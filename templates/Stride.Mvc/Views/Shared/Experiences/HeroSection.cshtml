@model Stride.Mvc._1.Models.Sections.HeroSection

@{
    ViewData.TryGetCompositionRenderingNode(out var renderingNode);
    var overlay = (renderingNode?.DisplaySettings != null && renderingNode.DisplaySettings.TryGetValue("backgroundOverlay", out var overlayVal)) ? overlayVal : "none";
}

<epi-grid class="hero-section relative">
    <epi-styles>
        <epi-style name="height">
            <epi-style-map value="small" class="min-h-[400px]" />
            <epi-style-map value="medium" class="min-h-[600px]" />
            <epi-style-map value="large" class="min-h-[800px]" />
            <epi-style-map value="fullscreen" class="min-h-screen" />
        </epi-style>
        <epi-style name="backgroundOverlay">
            <epi-style-map value="none" class="" />
            <epi-style-map value="blur" class="" />
        </epi-style>
    </epi-styles>

    <div class="bg-cover bg-center relative bg-no-repeat rounded-lg overflow-x-clip box-border w-full">
        @if (Model != null && Model.HeroImage != null && !ContentReference.IsNullOrEmpty(Model.HeroImage))
        {
            var mediaUrl = Url.ContentUrl(Model.HeroImage);
            var mediaPath = mediaUrl != null ? new Uri(mediaUrl, UriKind.RelativeOrAbsolute).IsAbsoluteUri
                ? new Uri(mediaUrl).AbsolutePath
                : mediaUrl.Split('?')[0].Split(',')[0]
                : null;
            var isVideo = mediaPath?.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ?? false;

            if (isVideo)
            {
                <video src="@mediaUrl"
                       autoplay
                       loop
                       muted
                       playsinline
                       class="@(overlay == "blur" ? "md:opacity-90 opacity-50" : "") absolute inset-0 w-full h-full object-cover rounded-lg"
                       epi-property="HeroImage"></video>
            }
            else
            {
                <img src="@mediaUrl"
                     alt="Hero background"
                     class="@(overlay == "blur" ? "md:opacity-90 opacity-50" : "") absolute inset-0 w-full h-full object-cover rounded-lg"
                     epi-property="HeroImage" />
            }

            if (overlay == "blur")
            {
                <div class="absolute inset-0 bg-gradient-to-t from-background2 via-background2/60 to-background2/30 rounded-lg z-[1]"></div>
            }
        }

        <epi-row class="h-[90vh] max-h-[900px] relative z-10 w-full container px-5 mx-auto flex gap-12 items-center py-20">
            <epi-column class="basis-0 grow">
                <epi-styles>
                    <epi-style name="role">
                        <epi-style-map value="content" class="grow-[2] space-y-6 flex flex-wrap gap-4 items-start content-center hero-content-col" />
                        <epi-style-map value="image" class="grow hidden md:block hero-image-col scroll-fade-up scroll-delay-4" />
                    </epi-style>
                </epi-styles>
                <epi-component class="w-full scroll-fade-up">
                    <epi-styles>
                        <epi-style name="width">
                            <epi-style-map value="full" class="!w-full" />
                            <epi-style-map value="half" class="!w-[calc(50%-0.5rem)]" />
                            <epi-style-map value="third" class="!w-[calc(33.333%-0.667rem)]" />
                        </epi-style>
                        <epi-style name="variant">
                            <epi-style-map value="primary" class="" />
                            <epi-style-map value="blue" class="" />
                            <epi-style-map value="outline" class="" />
                            <epi-style-map value="secondary" class="" />
                            <epi-style-map value="ghost" class="" />
                        </epi-style>
                        <epi-style name="level">
                            <epi-style-map value="h1" class="" />
                            <epi-style-map value="h2" class="" />
                            <epi-style-map value="h3" class="" />
                            <epi-style-map value="h4" class="" />
                            <epi-style-map value="h5" class="" />
                            <epi-style-map value="h6" class="" />
                        </epi-style>
                        <epi-style name="parallax">
                            <epi-style-map value="none" class="" />
                            <epi-style-map value="low" class="parallax-low" />
                            <epi-style-map value="medium" class="parallax-medium" />
                            <epi-style-map value="high" class="parallax-high" />
                        </epi-style>
                    </epi-styles>
                </epi-component>
            </epi-column>
        </epi-row>
    </div>
</epi-grid>
