@model IPageViewModel<ContactPage>

@{ Layout = "~/Views/Shared/Layouts/_LeftNavigation.cshtml"; }

<h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-8" epi-property="@Model.CurrentPage.Heading">
    @Model.CurrentPage.Heading
</h1>

@if (Model.CurrentPage.IntroText != null && !Model.CurrentPage.IntroText.IsEmpty)
{
    <div class="text-base leading-relaxed text-foreground/80 mb-8" epi-property="@Model.CurrentPage.IntroText">
        @Html.PropertyFor(m => m.CurrentPage.IntroText)
    </div>
}

<div class="space-y-4 text-base">
    @if (!string.IsNullOrEmpty(Model.CurrentPage.SupportEmail))
    {
        <div epi-property="@Model.CurrentPage.SupportEmail">
            <span class="font-semibold text-foreground">Support: </span>
            <span>
                @Model.CurrentPage.SupportEmail
            </span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.CurrentPage.PressEmail))
    {
        <div epi-property="@Model.CurrentPage.PressEmail">
            <span class="font-semibold text-foreground">Press: </span>
            <span>
                @Model.CurrentPage.PressEmail
            </span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.CurrentPage.PhoneNumber))
    {
        <div epi-property="@Model.CurrentPage.PhoneNumber">
            <span class="font-semibold text-foreground">Phone: </span>
            <span>
                @Model.CurrentPage.PhoneNumber
            </span>
        </div>
    }
</div>
