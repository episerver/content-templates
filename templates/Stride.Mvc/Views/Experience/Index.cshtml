@using Stride.Mvc.Models.ViewModels
@using Stride.Mvc.Models.Experiences
@using EPiServer.VisualBuilder
@model IPageViewModel<ExperienceData>
@addTagHelper *, EPiServer.Cms.AspNetCore.TagHelpers

@{
    var experienceData = Model.CurrentPage;
    ViewBag.Title = experienceData?.PageName ?? "Experience";
    Layout = "~/Views/Shared/Layouts/_Root.cshtml";

    var productExperience = experienceData as ProductExperience;
    var isProduct = productExperience != null;
    var badgeLabel = "";
    var badgeIcon = "sparkles";
    if (isProduct)
    {
        var productType = productExperience.ProductType ?? "features";
        badgeLabel = !string.IsNullOrEmpty(productExperience.BadgeLabel)
            ? productExperience.BadgeLabel
            : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(productType);
        badgeIcon = !string.IsNullOrEmpty(productExperience.BadgeIcon)
            ? productExperience.BadgeIcon
            : "sparkles";
    }
}

<div class="relative">
    @if (isProduct)
    {
        <div class="absolute top-[22vh] left-1/2 -translate-x-1/2 z-50 pointer-events-none">
            <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-foreground/60">
                <i data-lucide="@badgeIcon" class="w-3.5 h-3.5"></i>
                Stride @badgeLabel
            </span>
        </div>
    }

<epi-outline class="experience" experience="@experienceData">
    <epi-styles name="experienceContainer" class="experience-container" />
    
<epi-section class="experience-section">
        <epi-styles>
            <epi-style name="template" value="default" class="section-default" />
            <epi-style name="template" value="hero-section" class="hero-template" />
            <epi-style name="template" value="dark-section" class="dark-section" />
            <epi-style name="template" value="full-width" class="full-width-section" />
            <epi-style name="template" value="minimal" class="minimal-section" />
            <epi-style name="template" value="content-section" class="content-section py-4" />

            <epi-style name="height" value="small" class="section-height-small" />
            <epi-style name="height" value="medium" class="section-height-medium" />
            <epi-style name="height" value="large" class="section-height-large" />
            <epi-style name="height" value="fullscreen" class="section-height-fullscreen min-h-screen" />

            <epi-style name="backgroundColor" value="transparent" class="" />
            <epi-style name="backgroundColor" value="white" class="bg-white" />
            <epi-style name="backgroundColor" value="light" class="bg-gray-100" />
            <epi-style name="backgroundColor" value="dark" class="bg-gray-900 text-white" />
            <epi-style name="backgroundColor" value="primary" class="bg-primary text-white" />
            <epi-style name="backgroundColor" value="secondary" class="bg-gray-600 text-white" />

            <epi-style name="textAlignment" value="left" class="text-left" />
            <epi-style name="textAlignment" value="center" class="text-center" />
            <epi-style name="textAlignment" value="right" class="text-right" />

            <epi-style name="textColor" value="default" class="" />
            <epi-style name="textColor" value="white" class="text-white" />
            <epi-style name="textColor" value="black" class="text-gray-900" />
            <epi-style name="textColor" value="primary" class="text-primary" />
            <epi-style name="textColor" value="secondary" class="text-gray-600" />

            <epi-style name="padding" value="none" class="py-0" />
            <epi-style name="padding" value="small" class="py-2" />
            <epi-style name="padding" value="medium" class="py-4" />
            <epi-style name="padding" value="large" class="py-5" />
            <epi-style name="padding" value="xlarge" class="py-6" />

            <epi-style name="containerWidth" value="standard" class="container" />
            <epi-style name="containerWidth" value="wide" class="max-w-7xl mx-auto px-6" />
            <epi-style name="containerWidth" value="fluid" class="w-full px-6" />
            <epi-style name="containerWidth" value="narrow" class="max-w-3xl mx-auto px-6" />
        </epi-styles>
    </epi-section>

<epi-row class="experience-row">
        <epi-styles>
            <epi-style name="alignment" value="top" class="items-start" />
            <epi-style name="alignment" value="middle" class="items-center" />
            <epi-style name="alignment" value="bottom" class="items-end" />

            <epi-style name="spacing" value="none" class="gap-0" />
            <epi-style name="spacing" value="small" class="gap-2" />
            <epi-style name="spacing" value="medium" class="gap-4" />
            <epi-style name="spacing" value="large" class="gap-6" />
        </epi-styles>
    </epi-row>

<epi-column class="experience-column">
        <epi-styles>
            <epi-style name="verticalAlignment" value="top" class="self-start" />
            <epi-style name="verticalAlignment" value="middle" class="self-center" />
            <epi-style name="verticalAlignment" value="bottom" class="self-end" />

            <epi-style name="textAlignment" value="left" class="text-left" />
            <epi-style name="textAlignment" value="center" class="text-center" />
            <epi-style name="textAlignment" value="right" class="text-right" />

            <epi-style name="padding" value="none" class="p-0" />
            <epi-style name="padding" value="small" class="p-2" />
            <epi-style name="padding" value="medium" class="p-3" />
            <epi-style name="padding" value="large" class="p-4" />
        </epi-styles>
    </epi-column>

<epi-component class="experience-component">
        <epi-styles>
            <epi-style name="alignment" value="left" class="text-left" />
            <epi-style name="alignment" value="center" class="text-center" />
            <epi-style name="alignment" value="right" class="text-right" />

            <epi-style name="spacing" value="none" class="m-0" />
            <epi-style name="spacing" value="small" class="m-2" />
            <epi-style name="spacing" value="medium" class="m-3" />
            <epi-style name="spacing" value="large" class="m-4" />

            <epi-style name="theme" value="default" class="" />
            <epi-style name="theme" value="accent" class="theme-accent" />
            <epi-style name="theme" value="muted" class="theme-muted" />
            <epi-style name="theme" value="highlight" class="theme-highlight" />
        </epi-styles>
    </epi-component>
</epi-outline>
</div>
