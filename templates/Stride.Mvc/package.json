{
  "name": "stride-mvc",
  "version": "1.0.0",
  "description": "Stride MVC CMS Template",
  "scripts": {
    "build:css": "tailwindcss -i ./Assets/css/input.css -o ./wwwroot/css/output.css",
    "watch:css": "tailwindcss -i ./Assets/css/input.css -o ./wwwroot/css/output.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.1.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  }
}
