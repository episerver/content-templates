<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>true</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="EPiServer" />
    <Using Include="EPiServer.Core" />
    <Using Include="EPiServer.DataAbstraction" />
    <Using Include="EPiServer.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.Cms" Version="13.0.0" />
    <PackageReference Include="EPiServer.Cms.UI.AspNetIdentity" Version="13.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Translations\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="displaytemplates.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Tailwind CSS Build Integration -->
  <PropertyGroup>
    <TailwindInputFile>Assets\css\input.css</TailwindInputFile>
    <TailwindOutputFile>wwwroot\css\output.css</TailwindOutputFile>
    <TailwindConfigFile>tailwind.config.js</TailwindConfigFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Watch Tailwind input files for changes -->
    <TailwindContentFiles Include="Views\**\*.cshtml" />
    <TailwindContentFiles Include="Components\**\*.cs" />
    <TailwindContentFiles Include="Models\**\*.cs" />
  </ItemGroup>

  <Target Name="BuildTailwindCSS" BeforeTargets="BeforeBuild;BeforeRebuild" Inputs="$(TailwindInputFile);$(TailwindConfigFile);@(TailwindContentFiles)" Outputs="$(TailwindOutputFile)">
    <Message Importance="high" Text="Building Tailwind CSS..." />
    <Exec Command="npm run build:css" StandardOutputImportance="low" />
    <Touch Files="$(TailwindOutputFile)" AlwaysCreate="true" />
    <Message Importance="high" Text="Tailwind CSS build complete: $(TailwindOutputFile)" />
  </Target>
</Project>
